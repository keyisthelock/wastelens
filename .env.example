# Optional local/cloud configuration examples. Copy values into process env or a local .env.
AWS_REGION=ap-southeast-2
WASTELENS_BEDROCK_MODEL_ID=amazon.nova-lite-v1:0
# Nova Lite uses prompt_json with local response validation.
WASTELENS_BEDROCK_OUTPUT_MODE=prompt_json
WASTELENS_DYNAMODB_TABLE=
WASTELENS_UPLOAD_BUCKET=
WASTELENS_COMPLAINT_EMAIL_FROM=
WASTELENS_ADMIN_TOKEN_SECRET_ARN=
WASTELENS_ADMIN_TOKEN=
WASTELENS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
WASTELENS_DB=data/wastelens.db
VITE_API_URL=
# Public Web application OAuth client ID; no Google client secret is used.
WASTELENS_GOOGLE_CLIENT_ID=
# Optional production AI controls; deployed demo explicitly disables Bedrock while quota is zero.
WASTELENS_AI_DAILY_LIMIT=0
WASTELENS_BEDROCK_ENABLED=false
WASTELENS_REKOGNITION_GUIDE_FALLBACK=false
WASTELENS_API_BASE_PATH=/prod
